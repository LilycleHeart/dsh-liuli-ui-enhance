{
  "name": "dsh-liuli-ui-enhance",
  "description": "琉璃主题 —— DSH 界面增强插件：M3 动态取色、壁纸磨砂材质、声纹可视化、日/夜切换",
  "version": "0.1.0",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "liuli"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "bundle": "tsdown",
    "prepare": "pnpm build",
    "watch": "tsdown --watch",
    "install:desktop": "node scripts/install-desktop.mjs",
    "install:desktop:npm": "node scripts/install-desktop.mjs --from-npm",
    "patch:desktop": "node scripts/patch-desktop-frameless.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LilycleHeart/dsh-liuli-ui-enhance.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "react": "^18.2.0",
    "clsx": "^2.0.0",
    "react-dom": "^18.2.0",
    "iconv-lite": "^0.6.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-remotes": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-store": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-api-settings-controller": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-chat": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-model-selection": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-credentials": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-invariants": "^0.1.2-alpha.1",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-input-trigger": "^0.1.2-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-remotes": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-store": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-api-settings-controller": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-chat": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-model-selection": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-credentials": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-alpha.1",
    "@types/node": "^22.0.0",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-invariants": "^0.1.2-alpha.1",
    "@types/react": "~18.3.1",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-alpha.1",
    "@types/react-dom": "~18.3.0",
    "@deepseek-ai/dsh-client-ui-input-trigger": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "scripts/install-desktop.mjs",
    "scripts/patch-desktop-frameless.mjs",
    "cordis.patch.yml"
  ]
}
